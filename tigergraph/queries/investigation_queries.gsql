// TigerGraph Investigation GSQL Queries
// Graph: FraudGraph
// Core analytical library for Agentic Fraud Investigation

USE GRAPH FraudGraph

// -------------------------------------------------------------
// 1. GET TRANSACTION
// -------------------------------------------------------------
CREATE OR REPLACE QUERY get_transaction(VERTEX<Transaction> txn) FOR GRAPH FraudGraph {
    Start = {txn};
    
    CardOwner = SELECT c FROM Start:s -(PERFORMED_BY:e)-> Card:c;
    CustomerOwner = SELECT cust FROM CardOwner:c -(OWNED_BY:e)-> Customer:cust;
    DeviceUsed = SELECT d FROM Start:s -(USED_DEVICE:e)-> DeviceProfile:d;
    RegionBilled = SELECT r FROM Start:s -(BILLED_IN:e)-> BillingRegion:r;
    EmailUsed = SELECT em FROM Start:s -(PURCHASER_EMAIL:e)-> EmailDomain:em;

    PRINT Start;
    PRINT CardOwner;
    PRINT CustomerOwner;
    PRINT DeviceUsed;
    PRINT RegionBilled;
    PRINT EmailUsed;
}

// -------------------------------------------------------------
// 2. GET CUSTOMER TRANSACTION HISTORY
// -------------------------------------------------------------
CREATE OR REPLACE QUERY get_customer_transaction_history(VERTEX<Customer> cust, INT limit_count = 100) FOR GRAPH FraudGraph {
    Start = {cust};
    Cards = SELECT c FROM Start:s -(OWNS_CARD:e)-> Card:c;
    Txns = SELECT t FROM Cards:c -(PERFORMED_TXN:e)-> Transaction:t
           ORDER BY t.ts DESC
           LIMIT limit_count;
    
    Devices = SELECT d FROM Txns:t -(USED_DEVICE:e)-> DeviceProfile:d;

    PRINT Start;
    PRINT Cards;
    PRINT Txns;
    PRINT Devices;
}

// -------------------------------------------------------------
// 3. GET CARD TRANSACTION HISTORY
// -------------------------------------------------------------
CREATE OR REPLACE QUERY get_card_transaction_history(VERTEX<Card> card_node, INT limit_count = 100) FOR GRAPH FraudGraph {
    Start = {card_node};
    Txns = SELECT t FROM Start:s -(PERFORMED_TXN:e)-> Transaction:t
           ORDER BY t.ts DESC
           LIMIT limit_count;
    
    PRINT Start;
    PRINT Txns;
}

// -------------------------------------------------------------
// 4. GET TRANSACTION NEIGHBORHOOD (For Ego-Graph & UI)
// -------------------------------------------------------------
CREATE OR REPLACE QUERY get_transaction_neighborhood(VERTEX<Transaction> txn, INT max_hops = 2) FOR GRAPH FraudGraph {
    Start = {txn};
    
    // 1-Hop: Card, Device, Region, Email
    Cards = SELECT c FROM Start:s -(PERFORMED_BY:e)-> Card:c;
    Devices = SELECT d FROM Start:s -(USED_DEVICE:e)-> DeviceProfile:d;
    Regions = SELECT r FROM Start:s -(BILLED_IN:e)-> BillingRegion:r;
    Emails = SELECT em FROM Start:s -(PURCHASER_EMAIL:e)-> EmailDomain:em;
    Cases = SELECT cc FROM Start:s -(INVOLVED_IN_CASE:e)-> ClosedCase:cc;

    // 2-Hop: Customer, Other Cards on same Device
    Customers = SELECT cust FROM Cards:c -(OWNED_BY:e)-> Customer:cust;
    SiblingTxns = SELECT t FROM Devices:d -(USED_IN_TXN:e)-> Transaction:t LIMIT 50;
    SiblingCards = SELECT c FROM SiblingTxns:t -(PERFORMED_BY:e)-> Card:c;

    PRINT Start;
    PRINT Cards, Customers;
    PRINT Devices;
    PRINT Regions, Emails;
    PRINT Cases;
    PRINT SiblingCards;
}

// -------------------------------------------------------------
// 5. FIND SHARED DEVICES (Syndicate / Ring Detection)
// -------------------------------------------------------------
CREATE OR REPLACE QUERY find_shared_devices(VERTEX<DeviceProfile> dev) FOR GRAPH FraudGraph {
    Start = {dev};
    Txns = SELECT t FROM Start:s -(USED_IN_TXN:e)-> Transaction:t LIMIT 200;
    Cards = SELECT c FROM Txns:t -(PERFORMED_BY:e)-> Card:c;
    Customers = SELECT cust FROM Cards:c -(OWNED_BY:e)-> Customer:cust;

    PRINT Start;
    PRINT Cards;
    PRINT Customers;
}

// -------------------------------------------------------------
// 6. DETECT CARD TESTING SEQUENCE
// -------------------------------------------------------------
CREATE OR REPLACE QUERY detect_card_testing(VERTEX<Card> card_node, INT window_hours = 24) FOR GRAPH FraudGraph {
    Start = {card_node};
    
    // Low value authorizations (< $5.00) on online channel
    MicroTxns = SELECT t FROM Start:s -(PERFORMED_TXN:e)-> Transaction:t
                WHERE t.channel == "online" AND t.amount <= 5.0
                ORDER BY t.ts ASC;

    // Followed by larger purchases (> $50.00)
    LargeTxns = SELECT t FROM Start:s -(PERFORMED_TXN:e)-> Transaction:t
                WHERE t.amount >= 50.0
                ORDER BY t.ts ASC;

    PRINT Start;
    PRINT MicroTxns;
    PRINT LargeTxns;
}

// -------------------------------------------------------------
// 7. DETECT VELOCITY PATTERN
// -------------------------------------------------------------
CREATE OR REPLACE QUERY detect_velocity_pattern(VERTEX<Card> card_node, INT limit_count = 50) FOR GRAPH FraudGraph {
    Start = {card_node};
    Txns = SELECT t FROM Start:s -(PERFORMED_TXN:e)-> Transaction:t
           ORDER BY t.ts DESC
           LIMIT limit_count;

    PRINT Start;
    PRINT Txns;
}

// -------------------------------------------------------------
// 8. DETECT REGIONAL ANOMALY
// -------------------------------------------------------------
CREATE OR REPLACE QUERY detect_regional_anomaly(VERTEX<Transaction> txn) FOR GRAPH FraudGraph {
    Start = {txn};
    Cards = SELECT c FROM Start:s -(PERFORMED_BY:e)-> Card:c;
    AllCardTxns = SELECT t FROM Cards:c -(PERFORMED_TXN:e)-> Transaction:t
                  LIMIT 100;
    
    PRINT Start;
    PRINT AllCardTxns;
}

// -------------------------------------------------------------
// 9. GET HISTORICAL CLOSED CASES (Case Memory Retrieval)
// -------------------------------------------------------------
CREATE OR REPLACE QUERY get_historical_cases(VERTEX<Customer> cust, INT top_k = 5) FOR GRAPH FraudGraph {
    Start = {cust};
    Cards = SELECT c FROM Start:s -(OWNS_CARD:e)-> Card:c;
    
    // Direct cases on customer's cards
    DirectCases = SELECT cc FROM Cards:c -(HAS_CASE:e)-> ClosedCase:cc;
    
    // Connected cases via shared device
    Txns = SELECT t FROM Cards:c -(PERFORMED_TXN:e)-> Transaction:t;
    Devs = SELECT d FROM Txns:t -(USED_DEVICE:e)-> DeviceProfile:d;
    DevTxns = SELECT t FROM Devs:d -(USED_IN_TXN:e)-> Transaction:t;
    DevCards = SELECT c FROM DevTxns:t -(PERFORMED_BY:e)-> Card:c;
    ConnectedCases = SELECT cc FROM DevCards:c -(HAS_CASE:e)-> ClosedCase:cc;

    PRINT DirectCases;
    PRINT ConnectedCases;
}

// -------------------------------------------------------------
// 10. FIND CONNECTED CARDS
// -------------------------------------------------------------
CREATE OR REPLACE QUERY find_connected_cards(VERTEX<Card> card_node) FOR GRAPH FraudGraph {
    Start = {card_node};
    Customers = SELECT cust FROM Start:s -(OWNED_BY:e)-> Customer:cust;
    CustCards = SELECT c FROM Customers:cust -(OWNS_CARD:e)-> Card:c;

    Txns = SELECT t FROM Start:s -(PERFORMED_TXN:e)-> Transaction:t;
    Devs = SELECT d FROM Txns:t -(USED_DEVICE:e)-> DeviceProfile:d;
    DevTxns = SELECT t FROM Devs:d -(USED_IN_TXN:e)-> Transaction:t;
    DevCards = SELECT c FROM DevTxns:t -(PERFORMED_BY:e)-> Card:c;

    PRINT Start;
    PRINT CustCards;
    PRINT DevCards;
    PRINT Devs;
}

// -------------------------------------------------------------
// 11. PERSIST CASE NODE (Case Graph Writeback)
// -------------------------------------------------------------
CREATE OR REPLACE QUERY persist_case_node(
    STRING case_id,
    STRING status,
    STRING verdict,
    DOUBLE fraud_probability,
    STRING pattern,
    STRING pattern_description,
    DOUBLE exposure_usd,
    STRING summary,
    STRING triggering_txn_id,
    STRING card_id
) FOR GRAPH FraudGraph {
    INSERT INTO InvestigationCase (PRIMARY_ID, status, verdict, fraud_probability, pattern, pattern_description, exposure_usd, summary, created_at)
    VALUES (case_id, status, verdict, fraud_probability, pattern, pattern_description, exposure_usd, summary, now());
    
    IF triggering_txn_id != "" THEN
        INSERT INTO INVOLVES (FROM, TO) VALUES (case_id InvestigationCase, triggering_txn_id Transaction);
    END;
    
    IF card_id != "" THEN
        INSERT INTO ON_CARD (FROM, TO) VALUES (case_id InvestigationCase, card_id Card);
    END;
    
    PRINT "SUCCESS" AS result;
}

// -------------------------------------------------------------
// 12. WEAKLY CONNECTED COMPONENTS — Fraud Ring Detection
// Purpose: Identify clusters of Cards, Customers, and DeviceProfiles
//          that form connected components in the entity graph.
//          Components with >= 2 distinct customers sharing a device
//          profile are flagged as potential fraud syndicates.
// Algorithm: Iterative label propagation (WCC via vertex-cut BFS)
// -------------------------------------------------------------
CREATE OR REPLACE QUERY run_fraud_ring_wcc(
    VERTEX<Card> seed_card,
    INT max_depth = 3
) FOR GRAPH FraudGraph {
    // Traverse the FraudGraph Card-Transaction-Device-Transaction-Card
    // neighborhood from the seed. Global sets deduplicate component entities.
    SetAccum<UINT> @@component_cards;
    SetAccum<UINT> @@shared_device_profiles;
    SetAccum<UINT> @@connected_customers;
    SetAccum<UINT> @@seed_customers;

    Start = {seed_card};
    Start = SELECT s FROM Start:s
            ACCUM @@component_cards += getvid(s);

    SeedTransactions = SELECT t FROM Start:s -(PERFORMED_TXN:e1)-> Transaction:t;
    SharedDevices = SELECT d FROM SeedTransactions:t -(USED_DEVICE:e2)-> DeviceProfile:d
                    ACCUM @@shared_device_profiles += getvid(d);

    DeviceTransactions = SELECT t FROM SharedDevices:d -(USED_IN_TXN:e3)-> Transaction:t;
    PeerCards = SELECT c FROM DeviceTransactions:t -(PERFORMED_BY:e4)-> Card:c
                WHERE getvid(c) != getvid(seed_card)
                ACCUM @@component_cards += getvid(c);

    PeerCustomers = SELECT cust FROM PeerCards:c -(OWNED_BY:e5)-> Customer:cust
                    ACCUM @@connected_customers += getvid(cust);

    SeedCustomer = SELECT cust FROM Start:s -(OWNED_BY:e)-> Customer:cust
                   ACCUM @@connected_customers += getvid(cust),
                         @@seed_customers += getvid(cust);

    INT total_component_cards = @@component_cards.size();
    INT total_shared_devices = @@shared_device_profiles.size();
    INT peer_customer_count = @@connected_customers.size() - @@seed_customers.size();
    BOOL is_ring_detected = (peer_customer_count >= 1 AND total_shared_devices >= 1);
    PRINT Start AS SeedCard;
    PRINT PeerCards AS ComponentCards;
    PRINT PeerCustomers AS ComponentCustomers;
    PRINT SharedDevices AS SharedDeviceProfiles;
    PRINT total_component_cards AS ComponentCardCount;
    PRINT total_shared_devices AS SharedDeviceCount;
    PRINT peer_customer_count AS PeerCustomerCount;
    PRINT is_ring_detected AS FraudRingDetected;
}

INSTALL QUERY get_transaction, get_customer_transaction_history, get_card_transaction_history, get_transaction_neighborhood, find_shared_devices, detect_card_testing, detect_velocity_pattern, detect_regional_anomaly, get_historical_cases, find_connected_cards, persist_case_node, run_fraud_ring_wcc
